# Port HTTP (Render ustawia go sam)
PORT=3000

# Baza: lokalnie plik SQLite, na produkcji URL z Turso (libsql://...)
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# Sekret do podpisywania tokenów (na produkcji: długi losowy ciąg)
JWT_SECRET=change-me

# Wspólne konto do skanera
SCANNER_LOGIN=scanner
SCANNER_PASSWORD=scanner

# Wspólne konto administratora
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin

# Dozwolone originy frontendu (po przecinku)
CORS_ORIGIN=http://localhost:5173
